{
  "name": "Course Wallah Downloader",
  "description": "⚡ High-Performance, Multi-Platform Academic Video & PDF Downloader Telegram Bot with Single-Pass Watermarking & Multi-Bot Scalability",
  "keywords": [
    "telegram-bot",
    "video-downloader",
    "academic-parser",
    "pdf-watermark",
    "m3u8-downloader",
    "pyrogram",
    "multi-bot"
  ],
  "repository": "https://github.com/ramjipatel-tech/course-wallah-downloader-bot",
  "stack": "container",
  "env": {
    "API_ID": {
      "description": "Telegram API ID from https://my.telegram.org",
      "value": "",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API Hash from https://my.telegram.org",
      "value": "",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Primary Telegram Bot Token from @BotFather (or use BOT_1_TOKEN)",
      "value": "",
      "required": false
    },
    "BOT_1_TOKEN": {
      "description": "Bot 1 Token (for Multi-Bot architecture)",
      "value": "",
      "required": false
    },
    "BOT_2_TOKEN": {
      "description": "Bot 2 Token (Optional: starts Bot 2 dynamically)",
      "value": "",
      "required": false
    },
    "OWNER_ID": {
      "description": "Telegram Owner User ID",
      "value": "",
      "required": true
    },
    "ADMINS": {
      "description": "Comma-separated list of admin Telegram IDs",
      "value": "",
      "required": false
    },
    "DOWNLOAD_WORKERS": {
      "description": "Max concurrent download tasks (1-4)",
      "value": "4",
      "required": false
    },
    "UPLOAD_WORKERS": {
      "description": "Max concurrent upload tasks (1-3)",
      "value": "3",
      "required": false
    },
    "WATERMARK_TEXT": {
      "description": "Watermark text for videos and PDFs",
      "value": "Course Wallah",
      "required": false
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  }
}
