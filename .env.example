# ==============================================================================
# COURSE WALLAH TELEGRAM DOWNLOADER BOT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ==============================================================================
# 🔑 TELEGRAM API & BOT CREDENTIALS
# Obtain API_ID & API_HASH from https://my.telegram.org
# Obtain BOT_TOKENs from @BotFather on Telegram
# ==============================================================================
API_ID=12345678
API_HASH=your_telegram_api_hash_here

# Single-Bot Mode (Default / Legacy fallback)
BOT_TOKEN=your_telegram_bot_token_here

# Multi-Bot Mode (Concurrent independent bots in 1 process)
# Configure 1 to 10+ bots. Unset bots are skipped automatically.
BOT_1_TOKEN=
BOT_1_NAME=Course Wallah Main
BOT_1_SESSION=coursewallah_bot_1
BOT_1_FORUM_CHAT_ID=

BOT_2_TOKEN=
BOT_2_NAME=Course Wallah Bot 2
BOT_2_SESSION=coursewallah_bot_2
BOT_2_FORUM_CHAT_ID=

BOT_3_TOKEN=
BOT_3_SESSION=coursewallah_bot_3

BOT_4_TOKEN=
BOT_4_SESSION=coursewallah_bot_4

# Bot Identity & Branding
BOT_NAME="Course Wallah Downloader"
BOT_USERNAME="course_wallah_official_bot"
BOT_LINK="https://t.me/course_wallah_official_bot"
SUPPORT_LINK="https://t.me/course_wallah_official_bot"

# Owner & Administrators (Numeric Telegram User IDs, comma-separated)
OWNER_ID=123456789
ADMINS=123456789,987654321

# ==============================================================================
# ⚡ CONCURRENCY & WORKER SETTINGS
# ==============================================================================
DOWNLOAD_WORKERS=4
UPLOAD_WORKERS=3
MAX_ACTIVE_USERS=6
MAX_JOBS_PER_USER=1
MAX_RETRIES=3
RETRY_DELAY=5
SPAYEE_SEGMENT_WORKERS=16

# ==============================================================================
# 🎨 WATERMARK & BRANDING (Fast Stable libx264 DrawText)
# ==============================================================================
WATERMARK_TEXT="Course Wallah"
WATERMARK_FILE="Course Wallah"
WATERMARK_CRF=26
CREDIT="<a href='https://t.me/course_wallah_official_bot'>𝄟⃝⚡️ Course Wallah 💻 𝄟⃝🎓 🔥</a>"

# ==============================================================================
# 📁 CENTRALIZED STORAGE CONFIGURATION
# Supports: Local Windows, Linux, Railway Volume, Render Persistent Disk, Heroku
# ==============================================================================
# Windows Example: CW_STORAGE_DIR=B:\CourseWallahData
# Linux / Cloud Volume: CW_STORAGE_DIR=/data
# If unset, defaults safely to ./data relative to application root
CW_STORAGE_DIR=./data

# ==============================================================================
# 📢 TELEGRAM FORUM / SUPERGROUP SETTINGS (Optional)
# ==============================================================================
FORUM_CHAT_ID=""
RECORDED_TOPIC_ID=""
LIVE_TOPIC_ID=""
PREMIUM_CHANNEL=""

# ==============================================================================
# 🔧 TOOLS & BINARY PATHS
# ==============================================================================
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
PW_TOKEN=""

# ==============================================================================
# 🌐 WEB SERVER (Optional)
# ==============================================================================
WEB_SERVER=False
PORT=8000
